# MailPilot runner — systemd EnvironmentFile
# Install copies this to /etc/mailpilot/runner.env (mode 640, root:mailpilot).
# See mailpilot-runner/.env.example for variable descriptions.

# Flux (production — same DB as mailpilot-web)
FLUX_API_URL=https://api--your-project--hash.vsl-base.com
FLUX_SERVICE_TOKEN=your-flux-service-token
FLUX_POSTGREST_SCHEMA=api

# AI provider — openai (default) or cloudflare (Workers AI / Llama 8B)
# MAILPILOT_AI_PROVIDER=cloudflare
# MAILPILOT_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# MAILPILOT_CLOUDFLARE_API_TOKEN=your-api-token
# MAILPILOT_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# OpenAI (when MAILPILOT_AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# Optional tuning
MAILPILOT_POLL_INTERVAL_SECONDS=300
MAILPILOT_LOG_LEVEL=INFO
MAILPILOT_OPENAI_MODEL=gpt-4.1-mini
MAILPILOT_AI_MAX_SUBJECT_CHARS=200
MAILPILOT_AI_MAX_SNIPPET_CHARS=600
MAILPILOT_AI_MAX_BODY_CHARS=2000
MAILPILOT_ARCHIVE_RECEIPTS=0
MAILPILOT_ARCHIVE_SECURITY_NOISE=0
