# MailPilot Web — Docker Compose production env (.env.docker at repo root)
# Copy to repo root as .env.docker on the server (never commit the real file).
# Used by: docker compose --env-file .env.docker up -d --build web
#
# Build args (also passed at runtime via env_file):
NEXT_PUBLIC_APP_URL=https://mailpilot.vsl-base.com
NEXTAUTH_URL=https://mailpilot.vsl-base.com
NEXT_PUBLIC_FLUX_URL=https://api--mailpilot-ai--hash.vsl-base.com

# ── Auth.js app login ─────────────────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Google OAuth (app sign-in + Gmail connect) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Flux (server-only) ────────────────────────────────────────────────────────
FLUX_POSTGREST_SCHEMA=api
FLUX_SERVICE_TOKEN=

# ── Demo mode (production visitor demo) ─────────────────────────────────────
# Server authority — required for /demo/enter on production
ENABLE_DEMO_MODE=true
# UI hint only (login CTA); does NOT authorize demo entry by itself
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Operator / screenshot mode only — do NOT use for visitor demo
# MAILPILOT_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_BANNER=true
