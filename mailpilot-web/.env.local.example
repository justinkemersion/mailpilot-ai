# MailPilot Web — local environment variables
# Copy this file to .env.local and fill in your values.

# ── Auth.js app login ─────────────────────────────────────────────────────────
# Used for MailPilot application sign-in. This is separate from the Gmail OAuth
# flow below, which grants MailPilot access to process mail.
# GitHub callback:
#   http://localhost:3000/api/auth/callback/github
#   https://mailpilot.vsl-base.com/api/auth/callback/github
# Google sign-in callback:
#   http://localhost:3000/api/auth/callback/google
#   https://mailpilot.vsl-base.com/api/auth/callback/google
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_SECRET=<same-value-as-auth-secret>
# Must match the origin you open in the browser (same port as `npm run dev`).
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=<your-github-oauth-client-id>
AUTH_GITHUB_SECRET=<your-github-oauth-client-secret>

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID in Google Cloud Console → APIs & Services →
# Credentials. Application type: "Web application".
# Add the following to "Authorized redirect URIs":
#   http://localhost:3000/auth/google/callback   (local dev)
#   https://mailpilot.vsl-base.com/auth/google/callback  (production)
# If reusing this OAuth client for Google app sign-in, also add:
#   http://localhost:3000/api/auth/callback/google
#   https://mailpilot.vsl-base.com/api/auth/callback/google
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ── App URL ───────────────────────────────────────────────────────────────────
# Used to build absolute callback URLs. No trailing slash. Keep in sync with
# NEXTAUTH_URL when developing locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Mobile testing from your phone: Google OAuth rejects private IPs (10.x, 192.168.x)
# with "device id and device name are required". Options:
#   - Use production (https://mailpilot.vsl-base.com) on your phone, or
#   - Tunnel local dev (ngrok / Cloudflare Tunnel) and register the public HTTPS URL
#     in Google Cloud Console — do NOT register http://10.x.x.x redirect URIs.

# ── Flux target ───────────────────────────────────────────────────────────────
# Get the service token with `flux project credentials`.
NEXT_PUBLIC_FLUX_URL=https://api--mailpilot-ai--02d83e6.vsl-base.com
FLUX_POSTGREST_SCHEMA=api
FLUX_SERVICE_TOKEN=<server-only-service-token>

# ── Demo mode (optional) ──────────────────────────────────────────────────────
# Production visitor demo — server authority for /demo/enter (required in prod)
# ENABLE_DEMO_MODE=true
# Client UI hint only (login CTA visibility; does NOT authorize demo entry)
# NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Operator / screenshot mode only — forces fixtures for all requests
# Do NOT use for production visitor demo
# MAILPILOT_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_BANNER=true
