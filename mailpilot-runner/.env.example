# OpenAI (required for classification)
OPENAI_API_KEY=sk-your-key-here

# AI cost/quality tuning
# Balanced default for OpenAI mini: enough context for most emails without sending the full body.
MAILPILOT_AI_MAX_SUBJECT_CHARS=200
MAILPILOT_AI_MAX_SNIPPET_CHARS=600
MAILPILOT_AI_MAX_BODY_CHARS=2000
# For very small 8B-style models or extra-frugal OpenAI runs, try:
# MAILPILOT_AI_MAX_SUBJECT_CHARS=120
# MAILPILOT_AI_MAX_SNIPPET_CHARS=240
# MAILPILOT_AI_MAX_BODY_CHARS=0

# Future provider slot (documented now; runner still uses the OpenAI-backed classifier today)
MAILPILOT_AI_PROVIDER=openai
# Example future Cloudflare Worker endpoint on your own domain:
# MAILPILOT_CLOUDFLARE_BASE_URL=https://ai.example.com/mailpilot/classify
# MAILPILOT_CLOUDFLARE_API_TOKEN=your-cloudflare-token
# MAILPILOT_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Flux (production) — same PostgREST API as mailpilot-web (`flux project credentials`).
# When these are set, the runner prefers Flux over Supabase.
FLUX_API_URL=https://api--your-project--hash.vsl-base.com
FLUX_SERVICE_TOKEN=your-flux-service-token
FLUX_POSTGREST_SCHEMA=api

# Supabase (legacy local/dev) — omit when using Flux above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Optional tuning
MAILPILOT_POLL_INTERVAL_SECONDS=300
MAILPILOT_LOG_LEVEL=INFO
