# AI provider — choose one:
#   openai      — OpenAI API (default)
#   cloudflare  — Cloudflare Workers AI (free-tier friendly; Llama 8B default)

# --- OpenAI (when MAILPILOT_AI_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
# MAILPILOT_OPENAI_MODEL=gpt-4.1-mini

# --- Cloudflare Workers AI (when MAILPILOT_AI_PROVIDER=cloudflare) ---
# MAILPILOT_AI_PROVIDER=cloudflare
# MAILPILOT_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# MAILPILOT_CLOUDFLARE_API_TOKEN=your-api-token-with-workers-ai-read
# MAILPILOT_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Optional: full run URL override (custom Worker proxy) instead of account id + model
# MAILPILOT_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{id}/ai/run/{model}

# AI cost/quality tuning (applies to both providers)
# Balanced default: enough context for most emails without sending the full body.
MAILPILOT_AI_MAX_SUBJECT_CHARS=200
MAILPILOT_AI_MAX_SNIPPET_CHARS=600
MAILPILOT_AI_MAX_BODY_CHARS=2000
# Recommended for 8B Cloudflare models (cheaper + faster):
# MAILPILOT_AI_MAX_SUBJECT_CHARS=120
# MAILPILOT_AI_MAX_SNIPPET_CHARS=240
# MAILPILOT_AI_MAX_BODY_CHARS=0

MAILPILOT_AI_PROVIDER=openai

# Flux (required) — same PostgREST API as mailpilot-web (`flux project credentials`).
FLUX_API_URL=https://api--your-project--hash.vsl-base.com
FLUX_SERVICE_TOKEN=your-flux-service-token
FLUX_POSTGREST_SCHEMA=api

# Optional: mirror NEXT_PUBLIC_FLUX_URL for local dev parity with the web app
# NEXT_PUBLIC_FLUX_URL=https://api--your-project--hash.vsl-base.com

# Optional tuning
MAILPILOT_POLL_INTERVAL_SECONDS=300
MAILPILOT_LOG_LEVEL=INFO
